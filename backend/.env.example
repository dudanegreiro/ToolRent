# Copie este arquivo para backend/.env e troque os valores.
# O arquivo .env nao vai para o GitHub.

# Chave secreta do Django. Para gerar uma nova:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-secreta

# True para desenvolvimento, False em producao
DEBUG=True
